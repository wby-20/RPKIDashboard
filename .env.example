# Optional: enables Cloudflare Radar datasets during data refresh.
# Create a local .env file from this template; never commit real credentials.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional scheduler overrides.
SYNC_FAST_MINUTES=15
SYNC_MEDIUM_HOURS=8
SYNC_DAILY_HOURS=24

# Optional Python server settings.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
ASRANK_PROXY_CACHE_HOURS=8
